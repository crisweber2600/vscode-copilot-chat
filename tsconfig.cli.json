{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/cli",
    "rootDir": "src",
    "module": "commonjs",
    "target": "es2022",
    "moduleResolution": "node",
    "sourceMap": false,
    "declaration": false,
    "resolveJsonModule": false
  },
  "include": [
    "src/cli/**/*.ts",
    "src/models/**/*.ts",
    "src/services/**/*.ts"
  ]
}
